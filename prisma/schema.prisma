generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  BUYER
}

enum PayoutCadence {
  WEEKLY
  MONTHLY
}

enum FulfillmentMethod {
  PICKUP
  OWN_DELIVERY
  CARRIER
  REGIONAL
}

enum OrderStatus {
  PLACED
}

model PlatformSettings {
  id                  Int @id @default(1)
  globalCommissionBps Int @default(1000)
}

model Counter {
  id    String @id
  value Int    @default(0)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  tenantId     String?  @unique
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Tenant {
  id                      String             @id @default(cuid())
  name                    String
  slug                    String             @unique
  industryKey             String
  approved                Boolean            @default(false)
  openingHours            String
  story                   String
  pickupLabel             String
  pickupAddress           String
  latitude                Float
  longitude               Float
  individualCommissionBps Int                @default(0)
  payoutCadence           PayoutCadence      @default(WEEKLY)
  stripeAccountId         String?
  owner                   User?
  products                Product[]
  zoneMethods             TenantZoneMethod[]
  orderParts              OrderPart[]
  createdAt               DateTime           @default(now())

  @@index([approved])
}

model DeliveryZone {
  id      String             @id @default(cuid())
  key     String             @unique
  name    String
  sort    Int
  prices  ShippingPrice[]
  methods TenantZoneMethod[]
  orders  Order[]
}

model ShippingPrice {
  id         String            @id @default(cuid())
  zoneId     String
  zone       DeliveryZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  method     FulfillmentMethod
  priceCents Int

  @@unique([zoneId, method])
}

model TenantZoneMethod {
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId   String
  zone     DeliveryZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  method   FulfillmentMethod

  @@id([tenantId, zoneId, method])
}

model Product {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importKey   String
  name        String
  description String
  categoryKey String
  axisLabel   String?
  attributes  Json
  variants    Variant[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, importKey])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  priceCents Int
  stock      Int
  sku        String      @unique
  cartLines  CartLine[]
  orderLines OrderLine[]

  @@unique([productId, label])
}

model Cart {
  id        String     @id
  zoneId    String?
  lines     CartLine[]
  updatedAt DateTime   @updatedAt
}

model CartLine {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@unique([cartId, variantId])
}

model Order {
  id              String            @id @default(cuid())
  number          String            @unique
  accessToken     String            @unique
  email           String
  userId          String?
  user            User?             @relation(fields: [userId], references: [id])
  zoneId          String?
  zone            DeliveryZone?     @relation(fields: [zoneId], references: [id])
  method          FulfillmentMethod
  shippingCents   Int
  goodsCents      Int
  totalCents      Int
  status          OrderStatus
  stripePaymentId String?
  parts           OrderPart[]
  createdAt       DateTime          @default(now())

  @@index([email])
}

model OrderPart {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  goodsCents      Int
  globalBps       Int
  individualBps   Int
  commissionCents Int
  payoutCents     Int
  payoutCadence   PayoutCadence
  stripePayoutId  String?
  lines           OrderLine[]
}

model OrderLine {
  id           String    @id @default(cuid())
  partId       String
  part         OrderPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant   @relation(fields: [variantId], references: [id])
  productName  String
  variantLabel String
  quantity     Int
  unitCents    Int
}
